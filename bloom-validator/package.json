{
  "name": "bloom-validator",
  "version": "1.4.0",
  "description": "Validates self-contained Bloom .html artifacts against active construction and security rules",
  "type": "module",
  "bin": {
    "bloom-validate": "./src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test tests/validator.test.ts",
    "test:fixtures": "node --experimental-strip-types src/index.ts tests/fixtures/valid.html",
    "validate-all": "node scripts/validate-all.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": ["bloom", "html", "validator", "linter", "design-system"],
  "license": "MIT"
}
